# Veidne client environment variables.
#
# Copy this file to .env.development (used by `npm run dev`) or .env.production
# (used by `npm run build`). Both copies are gitignored. Vite exposes only
# variables prefixed VITE_ to the browser, so nothing in these files can be a
# secret; the values are public URLs and feature flags.

# Base URL of the PDF conversion service (Proteus). When this is unset the PDF
# export feature renders nothing and makes no network calls. The production site
# sets it to https://convert.veidne.com. A local converter listens on port 8085:
# VITE_CONVERT_API_URL=http://localhost:8085
VITE_CONVERT_API_URL=

# Image fields in the editor. Set to true to enable image placeholders; leave
# empty to keep them off, as in the production build.
VITE_IMAGE_FIELDS=
