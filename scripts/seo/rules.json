  "leadFacts": {
    "/": [
      { "fact": "free", "pattern": "\\bfree\\b" },
      { "fact": "runs in the browser", "pattern": "in (your|the) browser" },
      { "fact": "Word template and Excel", "pattern": "Word template[\\s\\S]*Excel" },
      { "fact": "one document per row", "pattern": "one personalized document per row" },
      { "fact": "no install, no account, no code", "pattern": "no install, no account, no code" },
      { "fact": "privacy statement", "pattern": "never (leave|leaves|uploaded)|are not uploaded|stays? on (your|this) device" }
    ]
  },
  "spaLinkTargets": ["/editor"],
  "forbiddenAssets": ["vendor-xlsx-", "vendor-docx-"],
  "noindexSources": [
    { "route": "/editor", "file": "src/features/editor/pages/Editor/Editor.tsx", "pattern": "<PageSeo[^>]*noindex" },
    { "route": "/thank-you", "file": "src/features/donation/pages/ThankYou/ThankYou.tsx", "pattern": "<PageSeo[^>]*noindex" },
    { "route": "(404)", "file": "src/features/marketing/pages/NotFound/NotFound.tsx", "pattern": "<PageSeo[^>]*noindex" }
  ],
  "budget": {
    "/": { "jsGzipTolerancePct": 1, "cssGzipAllowanceBytes": 1024 },
    "/free-online-mail-merge": { "jsGzipTolerancePct": 1, "cssGzipAllowanceBytes": 1024 },
    "/generate-word-documents-from-excel": { "jsGzipTolerancePct": 1, "cssGzipAllowanceBytes": 1024 },
    "/bulk-document-generation": { "jsGzipTolerancePct": 1, "cssGzipAllowanceBytes": 1024 },
    "/mail-merge-without-word": { "jsGzipTolerancePct": 1, "cssGzipAllowanceBytes": 1024 },
    "/about": { "jsGzipTolerancePct": 1, "cssGzipAllowanceBytes": 1024 }
  }
}
